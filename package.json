{
  "name": "mikrotik-mcp",
  "version": "0.2.0",
  "description": "MCP server for MikroTik RouterOS: manage routers via REST/API with confirmed writes, grounded in a local copy of the official MikroTik documentation.",
  "type": "module",
  "bin": {
    "mikrotik-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "scripts",
    "README.md",
    "routers.example.json"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "scrape": "node scripts/scrape-docs.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adhielesmana/mikrotik-mcp.git"
  },
  "homepage": "https://github.com/adhielesmana/mikrotik-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mikrotik",
    "routeros",
    "network-automation",
    "claude",
    "pppoe",
    "hotspot"
  ]
}
